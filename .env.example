# Copy to .env.local (never commit .env.local) and fill in the values.
# Every variable without NEXT_PUBLIC_ stays on the server and never reaches the browser.

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio → https://aistudio.google.com/apikey)
# Used for both embeddings and answer generation.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Embedding model. Must be the same for ingestion and search; changing it
# means re-embedding the whole corpus (python -m ingest.run --force).
GEMINI_EMBED_MODEL=gemini-embedding-001

# Fixed at 1536: the database column is vector(1536). Do not change.
GEMINI_EMBED_DIM=1536

# Model that writes answers. The "-latest" alias tracks Google's current Flash model;
# pin an exact model ID for reproducible behaviour.
GEMINI_CHAT_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key: full database access, bypasses row-level security.
# Server-side only. Never prefix with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App switches (safe to expose; contain no secrets)
# ---------------------------------------------------------------------------
# demo     = bundled 11-document demo corpus (no keys needed)
# supabase = real knowledge base via /api/rag (falls back to demo if keys are missing)
NEXT_PUBLIC_RAG_PROVIDER=demo

# simulated | open-meteo (live weather, no key needed)
NEXT_PUBLIC_WEATHER_PROVIDER=simulated
