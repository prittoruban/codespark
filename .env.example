# Copy to .env.local (never commit .env.local) and fill in the values.
# Every variable without NEXT_PUBLIC_ stays on the server and never reaches the browser.

# ---------------------------------------------------------------------------
# Embeddings: used for ingestion AND for every search query.
# Provider and model must be the same for both; changing them means clearing the
# tables and re-ingesting (python -m ingest.run).
# ---------------------------------------------------------------------------
# ollama (local, free, no rate limits) | gemini | openrouter
EMBED_PROVIDER=ollama
# Defaults: ollama → bge-m3 · gemini → gemini-embedding-001 · openrouter → openai/text-embedding-3-small
EMBED_MODEL=bge-m3
# Fixed at 1024: the database column is vector(1024). Do not change.
EMBED_DIM=1024
OLLAMA_URL=http://localhost:11434
# Pacing for cloud embedding providers (tokens per minute). Gemini free tier allows 30000.
# EMBED_TOKENS_PER_MINUTE=25000

# ---------------------------------------------------------------------------
# Answer generation
# ---------------------------------------------------------------------------
# gemini | ollama (local, slow on CPU) | openrouter
CHAT_PROVIDER=gemini
# Defaults: gemini → gemini-3.5-flash-lite · ollama → llama3.1:8b · openrouter → openai/gpt-4o-mini
CHAT_MODEL=gemini-3.5-flash-lite
# Backup models, tried in order when the main model is busy (503) or rate-limited (429).
CHAT_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# ---------------------------------------------------------------------------
# API keys (only the ones your providers need)
# ---------------------------------------------------------------------------
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: full database access, bypasses row-level security.
# Server-side only. Never prefix with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App switches (safe to expose; contain no secrets)
# ---------------------------------------------------------------------------
# demo     = bundled 11-document demo corpus (no keys needed)
# supabase = real knowledge base via /api/rag (falls back to demo if keys are missing)
NEXT_PUBLIC_RAG_PROVIDER=demo

# simulated | open-meteo (live weather, no key needed)
NEXT_PUBLIC_WEATHER_PROVIDER=simulated
